rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == "gy22brVxbsOlOGYVy0Vo4Xh4RMH3";
    }

    // BLOGS + BLOG CONTENT + DRAFTS (admin only)
    match /blogs/{id} {
      allow read: if true;          // public can read published blogs
      allow write: if isAdmin();    // only you can create/update/delete
    }

    match /blogContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /drafts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // COMMENTS (public write allowed?)
    match /comments/{id} {
      allow read: if true;

      // if you want ANYONE to post comments:
      allow write: if request.time < timestamp.date(2100, 1, 1);

      // or: only authenticated users
      // allow write: if request.auth != null;
    }

    // Topics, Tags, Featured, Milestones – admin write
    match /blogTopics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featuredBlogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /milestones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
